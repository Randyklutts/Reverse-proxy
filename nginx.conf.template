worker_processes 1;

events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # 🔑 KEY FIX: force IPv4, re-resolve DNS every 10s
    resolver 127.0.0.11 valid=10s ipv6=off;

    # 🔑 KEY FIX: bigger buffers for large upstream headers (cookies, CSP)
    proxy_buffer_size          16k;
    proxy_buffers              8 16k;
    proxy_busy_buffers_size    32k;
    proxy_temp_file_write_size 64k;
    proxy_max_temp_file_size   0;

    log_format traffic '$remote_addr|$time_iso8601|"$request"|$status|'
                       '$body_bytes_sent|"$http_user_agent"|"$http_x_forwarded_for"|'
                       '"$cookie_${SESSION_COOKIE_NAME}"|"$cookie_${USER_COOKIE_NAME}"';

    access_log /var/log/nginx/access.log traffic;
    error_log  /var/log/nginx/error.log warn;

    server {
        listen       ${PORT};
        server_name  _;

        location / {
            # Variable forces runtime DNS re-resolution
            set $upstream "${TARGET_URL}";
            proxy_pass $upstream$request_uri;

            # 🔑 SNI + TLS correctness
            proxy_ssl_server_name on;
            proxy_ssl_name $proxy_host;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;

            # 🔑 Force IPv4 upstream (matches resolver ipv6=off)
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header User-Agent $http_user_agent;
            proxy_set_header Accept-Encoding "";

            # 🔑 Timeouts
            proxy_connect_timeout 15s;
            proxy_read_timeout    60s;
            proxy_send_timeout    60s;

            # 🔑 Follow upstream redirects gracefully (do not rewrite Location)
            proxy_redirect off;

            # 🔑 Handle large headers
            proxy_buffer_size          16k;
            proxy_buffers              8 16k;
            proxy_busy_buffers_size    32k;
        }

        location /tg-webhook/ {
            proxy_pass http://127.0.0.1:8080/webhook/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}
